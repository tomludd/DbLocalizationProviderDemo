<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- LocalizationProvider 9.x targets net10.0 only -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Off to match typical Optimizely/CMS projects that will copy this code -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core provider + DI registration (AddDbLocalizationProvider). No Admin UI, no CMS integration. -->
    <PackageReference Include="LocalizationProvider" Version="9.1.0" />
    <PackageReference Include="LocalizationProvider.AspNetCore" Version="9.1.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roslyn analyzer: runs at compile time only, not shipped with the app -->
    <ProjectReference Include="..\LocalizationAnalyzers\LocalizationAnalyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
