<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers must target netstandard2.0 to load in every compiler host (dotnet build, VS, Rider) -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      An analyzer can't be loaded by a compiler older than the Microsoft.CodeAnalysis version it references.
      5.0.0 is the Roslyn version in the first .NET 10 SDK (10.0.100), so it works in every .NET 10 SDK / VS 2026.
      Don't bump to the newest Roslyn unless you also require a newer SDK.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
